<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>zrr</AssemblyName>
    <RootNamespace>Zurari</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Zurari.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Zurari.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" GeneratePathProperty="true" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="CopyThirdPartyNotices" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.txt"
          DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="$(PkgSkiaSharp)\LICENSE.txt;$(PkgSkiaSharp_NativeAssets_Linux_NoDependencies)\THIRD-PARTY-NOTICES.txt"
          DestinationFiles="$(PublishDir)SkiaSharp-LICENSE.txt;$(PublishDir)SkiaSharp-THIRD-PARTY-NOTICES.txt" />
  </Target>
</Project>
